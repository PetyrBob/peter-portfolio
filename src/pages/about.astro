---
import { getEntry, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { categories, categoryKeys, site } from '../data/site';

// The text comes from src/content/pages/about.md (edit it in Pages CMS under "About page").
const about = await getEntry('pages', 'about');
if (!about) throw new Error('Missing src/content/pages/about.md');
const { Content } = await render(about);
---

<Layout title={about.data.title} description={`About ${site.name}.`}>
  <div class="page pt-10">
    <h1 class="display text-6xl md:text-8xl">{about.data.title}</h1>
    <div class="mt-10 grid gap-12 md:grid-cols-[1fr_20rem]">
      <div class="prose-case text-xl [&>p:first-child]:mt-0">
        <Content />
        {site.resume && <p><a href={site.resume}>Download my resume</a></p>}
      </div>
      <div>
        <h2 class="font-display text-2xl font-bold text-cobalt">What I do</h2>
        <ul class="mt-3 grid gap-1">
          {categoryKeys.map((key) => <li><a class="underline" href={`/work/category/${key}/`}>{categories[key].label}</a></li>)}
        </ul>
      </div>
    </div>
  </div>
</Layout>
