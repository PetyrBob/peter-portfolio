---
import Layout from '../layouts/Layout.astro';
import { categories, categoryKeys, site } from '../data/site';
---

<Layout title="About" description={`About ${site.name}.`}>
  <div class="page pt-10">
    <h1 class="display text-6xl md:text-8xl">About</h1>
    <div class="mt-10 grid gap-12 md:grid-cols-[1fr_20rem]">
      <div class="max-w-[60ch] space-y-4 text-xl">
        <p>
          I'm Peter Bob Domogma. I work in IT with a focus on UI/UX design, and I also design logos,
          brands, social media posts and print pieces. Because I build front-ends too, I can take a
          design from first sketch to working page.
        </p>
        <p>I'm looking for an internship where I can do real design and front-end work with a team.</p>
        {site.resume && <p><a class="text-cobalt underline" href={site.resume}>Download my resume</a></p>}
      </div>
      <div>
        <h2 class="font-display text-2xl font-bold text-cobalt">What I do</h2>
        <ul class="mt-3 grid gap-1">
          {categoryKeys.map((key) => <li><a class="underline" href={`/work/category/${key}/`}>{categories[key].label}</a></li>)}
        </ul>
      </div>
    </div>
  </div>
</Layout>
